rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {

        function isSignedIn() {
            return request.auth != null;
        }

        function hasStaffProfile() {
            return isSignedIn()
                && exists(/databases/$(database)/documents/users/$(request.auth.uid));
        }

        function staffProfile() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        }

        function isStaffActive() {
            return hasStaffProfile() && staffProfile().get('active', true) != false;
        }

        // Keep email lists synchronized with ADMIN_EMAILS in adminwebsite.js.
        // Recognizes custom claim admin == true, configured owner/admin emails, or active POS OWNER profile.
        function isAdmin() {
            return isSignedIn() && (
                request.auth.token.get('admin', false) == true ||
                request.auth.token.email in [
                    "owner@hungrybirds.com"
                ] ||
                (
                    request.auth.token.email in [
                        "rehan@hungrybirds-pos.local"
                    ] &&
                    isStaffActive() &&
                    staffProfile().get('role', null) in ['OWNER', 'owner', 'admin']
                ) ||
                (isStaffActive() && staffProfile().get('role', null) == 'OWNER')
            );
        }

        function isManagerOrOwner() {
            return isAdmin() || (
                isStaffActive()
                && staffProfile().get('role', null) in ['OWNER', 'MANAGER']
            );
        }

        function isCashierOrAbove() {
            return isAdmin() || (
                isStaffActive()
                && staffProfile().get('role', null) in ['OWNER', 'MANAGER', 'CASHIER']
            );
        }

        // Staff accounts have an active profile doc keyed by their auth uid carrying an explicit POS role.
        // Customer loyalty docs in /users/{uid} cannot set role/isStaff/active, so customers cannot become staff.
        function isStaff() {
            return isAdmin() || (
                isStaffActive()
                && (
                    staffProfile().get('isStaff', false) == true ||
                    staffProfile().get('role', null) in ['OWNER', 'MANAGER', 'CASHIER', 'WAITER']
                )
            );
        }

        // The customer website needs to display the published POS menu.
        // Managers and owners remain responsible for menu/category catalog writes.
        match /menu/{menuId} {
            allow read: if true;
            allow write: if isManagerOrOwner();
        }

        match /categories/{categoryId} {
            allow read: if true;
            allow write: if isManagerOrOwner();
        }

        // Promotional banners displayed publicly on the website; managed by admin only.
        match /banners/{bannerId} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Customer orders contain PII and are strictly scoped to owner or staff.
        // Guest order status tracking reads the sanitized /orderTracking/{orderId} projection.
        match /onlineOrders/{orderId} {
            allow get, list: if isSignedIn() && (resource.data.customerUid == request.auth.uid || isStaff());

            allow create: if isStaff() || (
                isSignedIn() &&
                request.resource.data.customerUid == request.auth.uid &&
                request.resource.data.status == 'PENDING' &&
                request.resource.data.source == 'website' &&
                request.resource.data.orderType in ['DELIVERY', 'TAKEAWAY'] &&
                request.resource.data.items is list &&
                request.resource.data.items.size() > 0 &&
                request.resource.data.items.size() <= 50 &&
                request.resource.data.subtotal is number &&
                request.resource.data.subtotal > 0 &&
                (request.resource.data.orderType != 'DELIVERY' || request.resource.data.subtotal >= 500) &&
                request.resource.data.discountAmount is number &&
                request.resource.data.discountAmount >= 0 &&
                request.resource.data.discountAmount <= request.resource.data.subtotal &&
                request.resource.data.total == request.resource.data.subtotal - request.resource.data.discountAmount &&
                request.resource.data.customer is map &&
                request.resource.data.customer.phone is string &&
                request.resource.data.customer.phone.size() >= 7 &&
                request.resource.data.customer.phone.size() <= 20
            );

            allow update: if isStaff();
            allow delete: if isAdmin();
        }

        // Public non-PII tracking projection (excludes name, phone, address, and customerUid).
        // Collection listing is disabled so guests can only query a specific order ID they hold.
        match /orderTracking/{orderId} {
            allow get: if true;
            allow list: if false;

            allow create: if isSignedIn() &&
                request.resource.data.keys().hasOnly(['orderId', 'status', 'orderType', 'total', 'createdAt']) &&
                request.resource.data.orderId == orderId &&
                request.resource.data.status == 'PENDING' &&
                request.resource.data.orderType in ['DELIVERY', 'TAKEAWAY'] &&
                request.resource.data.total is number &&
                request.resource.data.total >= 0;

            allow update: if isStaff();
            allow delete: if isAdmin();
        }

        // POS sales & inventory collections with POS role granularity.
        match /sales/{saleId} {
            allow read: if isStaff();
            allow create: if isCashierOrAbove();
            allow update: if isStaff();
            allow delete: if isManagerOrOwner();
        }

        match /inventory/{itemId} {
            allow read: if isStaff();
            allow update: if isCashierOrAbove();
            allow create, delete: if isManagerOrOwner();
        }

        // Public username -> auth email lookup used by POS login screen (.doc(username).get()).
        // Listing disabled to prevent staff enumeration.
        match /usernameDirectory/{usernameLower} {
            allow get: if true;
            allow list: if false;
            allow write: if isAdmin();
        }

        // Per-customer loyalty tracking (orderCount) and staff profile docs (keyed by uid).
        // Customers may only create/increment their own loyalty counter and can never set role/isStaff/active.
        match /users/{userId} {
            allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isStaff());

            allow create: if isAdmin() || (
                isSignedIn() &&
                request.auth.uid == userId &&
                request.resource.data.keys().hasOnly(['email', 'orderCount', 'updatedAt']) &&
                !request.resource.data.keys().hasAny(['role', 'isStaff', 'active', 'permissions']) &&
                request.resource.data.get('orderCount', 0) in [0, 1]
            );

            allow update: if isAdmin() || (
                isSignedIn() &&
                request.auth.uid == userId &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'orderCount', 'updatedAt']) &&
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isStaff', 'active', 'permissions']) &&
                request.resource.data.orderCount == resource.data.get('orderCount', 0) + 1
            );

            allow delete: if isAdmin();
        }

        // Coupons: only admins (and server Cloud Functions) can create/delete coupons.
        // Customers can read assigned/public coupons by code and only perform one-way redemption updates.
        match /coupons/{couponId} {
            allow get: if isSignedIn();
            allow list: if isAdmin() || (isSignedIn() && resource.data.assignedTo == request.auth.uid);

            allow create: if isAdmin();

            allow update: if isAdmin() || (
                isSignedIn() &&
                resource.data.get('active', true) == true &&
                (
                    (
                        resource.data.singleUse == true &&
                        resource.data.get('used', false) == false &&
                        resource.data.assignedTo == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'used']) &&
                        request.resource.data.active == false &&
                        request.resource.data.used == true
                    ) ||
                    (
                        resource.data.singleUse == false &&
                        (!('assignedTo' in resource.data) || resource.data.assignedTo == null) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
                        request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1 &&
                        (resource.data.get('maxUses', null) == null || request.resource.data.usedCount <= resource.data.maxUses)
                    )
                )
            );

            allow delete: if isAdmin();
        }

        // POS-only collections: synced from local Dexie via echo-guarded onSnapshot.
        // All active staff can read/sync; back-office mutations require Manager/Owner.
        match /suppliers/{supplierId} {
            allow read: if isStaff();
            allow write: if isManagerOrOwner();
        }

        match /stockIn/{stockInId} {
            allow read: if isStaff();
            allow write: if isManagerOrOwner();
        }

        match /supplierPayments/{paymentId} {
            allow read: if isStaff();
            allow write: if isManagerOrOwner();
        }

        match /supplierLedger/{ledgerId} {
            allow read: if isStaff();
            allow write: if isManagerOrOwner();
        }

        match /expenses/{expenseId} {
            allow read: if isStaff();
            allow write: if isManagerOrOwner();
        }

        match /deliveries/{deliveryId} {
            allow read, write: if isStaff();
        }

        match /staff/{staffId} {
            allow read: if isStaff();
            allow write: if isManagerOrOwner();
        }

        match /attendance/{attendanceId} {
            allow read: if isStaff();
            allow write: if isManagerOrOwner();
        }

        match /leaves/{leaveId} {
            allow read: if isStaff();
            allow write: if isManagerOrOwner();
        }

        match /salaryPayments/{paymentId} {
            allow read: if isStaff();
            allow write: if isManagerOrOwner();
        }

        match /advancePayments/{advanceId} {
            allow read: if isStaff();
            allow write: if isManagerOrOwner();
        }

        match /auditLogs/{logId} {
            allow read, create: if isStaff();
            allow update, delete: if isAdmin();
        }

        match /heldOrders/{orderId} {
            allow read, write: if isStaff();
        }

        match /tableOrders/{orderId} {
            allow read: if isStaff();
            allow write: if orderId == 'setting_ownerPinHash' ? isAdmin() : isStaff();
        }

        match /recipes/{recipeId} {
            allow read: if isStaff();
            allow write: if isManagerOrOwner();
        }

        match /customers/{customerId} {
            allow read: if isStaff();
            allow write: if isCashierOrAbove();
        }
    }
}
