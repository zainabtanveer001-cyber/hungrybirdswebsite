rules_version = '2';

service firebase.storage {
    match /b/{bucket}/o {
        function isSignedIn() {
            return request.auth != null;
        }

        // Keep in sync with firestore.rules isAdmin() and adminwebsite.js ADMIN_EMAILS.
        // POS app does not upload to Firebase Storage; only website promotional banners live here.
        function isAdmin() {
            return isSignedIn() && (
                request.auth.token.get('admin', false) == true ||
                request.auth.token.email in [
                    "owner@hungrybirds.com",
                    "rehan@hungrybirds-pos.local"
                ]
            );
        }

        // Promotional banner assets are publicly readable and strictly admin-managed.
        match /banners/{bannerId}/{fileName} {
            allow read: if true;
            allow write: if isAdmin() &&
                request.resource != null &&
                request.resource.size > 0 &&
                request.resource.size < 5 * 1024 * 1024 &&
                request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
            allow delete: if isAdmin();
        }

        // Deny all other storage paths by default.
        match /{allPaths=**} {
            allow read, write: if false;
        }
    }
}
